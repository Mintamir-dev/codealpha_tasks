NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Set DATABASE_SSL=true for most hosted databases.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pm_tool
DATABASE_SSL=false

# Use a long random value in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_COST=10

# Front-end origin(s) allowed to call the API (comma separated).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Used for "overdue", "due today / this week" and weekly reports.
APP_TIMEZONE=Africa/Addis_Ababa

# NFR-SEC-08: 5 failed log-ins in 10 minutes => "Try again later"
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10

# Used only by `npm run db:seed` to create the first administrator.
ADMIN_NAME=Meron Alemu
ADMIN_EMAIL=meron@example.com
ADMIN_PASSWORD=ChangeMe123
