# Leave empty in development: Vite forwards /api and /socket.io to the backend (see vite.config.js).
# In production, set this to the public URL of the API, e.g. https://api.example.com
# (and add this site's address to CORS_ORIGIN in the backend .env).
VITE_API_URL=

# Where the dev server forwards API calls (default http://localhost:4000)
VITE_PROXY_TARGET=http://localhost:4000
